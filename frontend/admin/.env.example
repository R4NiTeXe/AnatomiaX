# AnatomiaX Admin — copy to .env.local for local dev
# Public (client) variables must be prefixed with NEXT_PUBLIC_ to be exposed to the browser.

# Backend API base (must match CORS_ORIGIN on the server)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Alternative fallback used by shared lib/api (also respects VITE_API_BASE_URL)
# VITE_API_BASE_URL=http://localhost:3000
