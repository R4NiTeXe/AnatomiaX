# AnatomiaX Admin — copy to .env.local for local dev
# See docs/deployment/README.md for the staging/production contract.
# Classification: NEXT_PUBLIC_* values are PUBLIC BUILD-TIME (sent to the browser).
# Never put secrets (JWT_SECRET, DATABASE_URL, OAuth secrets, FCM keys) here.

# Backend API base (must match CORS_ORIGIN on the server)
# Local: http://localhost:3000. Staging/production: explicit HTTPS API origin.
# Production must not silently use localhost — set this explicitly at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Alternative fallback used by shared lib/api (also respects VITE_API_BASE_URL)
# VITE_API_BASE_URL=http://localhost:3000
