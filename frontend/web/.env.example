# AnatomiaX web env — copy to .env for local dev
# See docs/architecture/asset-hosting.md for production asset hosting.
# See docs/deployment/README.md for the staging/production contract.
# Classification: VITE_* values are PUBLIC BUILD-TIME (baked into the bundle).
# Never put secrets (JWT_SECRET, DATABASE_URL, OAuth secrets, FCM keys) here.

# Backend API (required)
# Local: http://localhost:3000. Staging/production: explicit HTTPS API origin.
# Production must not silently use localhost — set this explicitly at build time.
VITE_API_BASE_URL=http://localhost:3000

# Anatomy 3D assets (optional)
# Local dev (default, no env needed): serves 13 representative GLBs from
#   frontend/web/public/models-dev/ as flat files:
#     /models-dev/skin-meshopt.glb
#     /models-dev/female-skin-meshopt.glb
#   This is a dev subset, gitignored (*.glb), reproduced from
#   3d-assets/<bodyModel>/working/optimized/. Fresh clone works without it.
#
# Production (host 18 optimized GLBs on any static HTTPS host):
#   Provide an HTTPS base URL; the web resolves every manifest entry as
#     <base>/<bodyModel>/<file>
#   where <file> is the production filename from assetManifest.ts
#   (e.g. skin-meshopt.glb) and <bodyModel> is male|female.
#   The manifest carries no host — any provider works (S3+CloudFront,
#   GCS, Azure, R2, Netlify, Vercel static, nginx, etc.).
#   Trailing slash is optional; Vite injects as import.meta.env.VITE_ANATOMY_ASSET_BASE_URL.
#   Production must be HTTPS and must not target localhost.
#   See docs/architecture/asset-hosting.md for required headers.
#
# Examples:
#   VITE_ANATOMY_ASSET_BASE_URL=https://assets.anatomiax.example/anatomy/
#   VITE_ANATOMY_ASSET_BASE_URL=https://cdn.example/static/anatomy
#   (both normalize to ensure the <bodyModel>/<file> suffix resolves)
VITE_ANATOMY_ASSET_BASE_URL=/models-dev/
