{
  "name": "@anatomiax/marketing",
  "private": true,
  "version": "0.1.0",
  "description": "AnatomiaX marketing website - 11ty + Tailwind CSS + daisyUI",
  "scripts": {
    "dev": "concurrently \"npm:dev:eleventy\" \"npm:dev:css\" \"npm:dev:js\"",
    "dev:eleventy": "eleventy --serve",
    "dev:css": "tailwindcss -i ./src/styles/main.css -o ./_site/styles/main.css --watch",
    "dev:js": "esbuild src/scripts/animations.js --bundle --outfile=_site/scripts/animations.js --watch",
    "build": "eleventy && npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./src/styles/main.css -o ./_site/styles/main.css --minify",
    "build:js": "esbuild src/scripts/animations.js --bundle --outfile=_site/scripts/animations.js --minify --format=iife --target=es2020",
    "build:eleventy": "eleventy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "daisyui": "^4.12.14",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "lenis": "^1.3.8"
  }
}
