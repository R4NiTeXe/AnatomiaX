# AnatomiaX Marketing — copy to .env for local dev
# Site URL is the canonical HTTPS origin for the public site.
# Used for <link rel="canonical">, sitemap.xml, robots.txt, og:url, JSON-LD.
# Local default is https://anatomiax.example (placeholder, not a real domain).
SITE_URL=https://anatomiax.example
# Alternative: eleventy also reads URL (Netlify convention)
# URL=https://anatomiax.example
# Contact placeholder (not real production contact)
CONTACT_EMAIL=contact@anatomiax.example
