# 3D assets large files (keep structure, ignore raw unoptimized if needed)
# Uncomment if large assets should not be tracked:
# 3d-assets/**/*.blend
# 3d-assets/**/*.fbx
# 3d-assets/**/*.obj

# NIH/HRA original source GLBs — kept locally, not in Git (reproducible via scripts/download-anatomy-assets)
3d-assets/male/source/*.glb
3d-assets/female/source/*.glb

# Working split GLBs — generated, not final, not in Git
3d-assets/male/working/*.glb
3d-assets/male/working/**/*.glb
3d-assets/male/working/optimized/*.glb

# Temporary local dev-test copies of optimized GLBs (served by Vite from public/models-dev).
# Reproduce via: copy files from 3d-assets/male/working/optimized/ — never commit these.
frontend/web/public/models-dev/*.glb

