{
  "name": "anatomiax",
  "private": true,
  "version": "0.1.0",
  "description": "AnatomiaX - Interactive 3D human anatomy learning platform",
  "workspaces": [
    "frontend/marketing",
    "frontend/web",
    "frontend/admin",
    "frontend/packages/*",
    "backend/api",
    "backend/packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @anatomiax/marketing",
    "build": "npm run build -w @anatomiax/marketing",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "prettier": "^3.3.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
