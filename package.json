{
  "name": "anatomiax",
  "private": true,
  "version": "0.1.0",
  "description": "AnatomiaX - Interactive 3D human anatomy learning platform",
  "workspaces": [
    "frontend/marketing",
    "frontend/web",
    "frontend/admin",
    "frontend/packages/*",
    "backend/api",
    "backend/packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @anatomiax/marketing",
    "build": "npm run build -w @anatomiax/marketing",
    "build:api": "npm run build -w @anatomiax/api",
    "start:api": "npm run start:prod -w @anatomiax/api",
    "migrate:api": "npx prisma migrate deploy --schema backend/api/prisma/schema.prisma",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/cli": "^4.4.2",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "playwright": "^1.62.1",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.71.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.5"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=9.0.0"
  }
}
