# AnatomiaX API env — copy to .env for local dev. See docs/deployment/README.md.
# Classification: ALL values here are SERVER-ONLY. Never expose via VITE_*/NEXT_PUBLIC_*.
PORT=3000
# Bind host. Local dev may use 127.0.0.1; production default is 0.0.0.0 (see main.ts).
HOST=127.0.0.1
# Comma-separated allow-list (web, admin). Production: HTTPS origins only, no "*" and no localhost.
CORS_ORIGIN=http://localhost:5173
# PostgreSQL connection string (Prisma). Never commit real credentials.
# Example: postgresql://postgres:postgres@localhost:5432/anatomiax
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anatomiax
# JWT access-token signing secret. REQUIRED in production (app refuses to boot without it).
JWT_SECRET=change-me-to-a-long-random-secret
# Access-token lifetime (e.g. 15m) and refresh-token lifetime in days.
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# Password-reset token lifetime in minutes (single-use, hashed at rest).
PASSWORD_RESET_TTL_MINUTES=60
# Refresh-cookie flags. Secure cookies are forced in production regardless.
# Production rule: COOKIE_SAMESITE=none requires COOKIE_SECURE=true (browser-enforced).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Google OAuth (https://console.cloud.google.com/apis/credentials). Never commit real values.
# Optional: leave both ID and SECRET empty to disable. If enabled, set both plus a
# non-localhost HTTPS GOOGLE_CALLBACK_URL in staging/production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Push notifications (8.19.24, Firebase free path). Empty = sender stays stubbed, nothing is sent.
# FCM legacy server key (Firebase console → Project settings → Cloud Messaging). Never commit real values.
FCM_SERVER_KEY=
# Firebase project id (required only if FCM_SERVER_KEY is set).
FIREBASE_PROJECT_ID=
