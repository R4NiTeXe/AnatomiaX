PORT=3000
CORS_ORIGIN=http://localhost:5173
# PostgreSQL connection string (Prisma). Never commit real credentials.
# Example: postgresql://postgres:postgres@localhost:5432/anatomiax
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anatomiax
# JWT access-token signing secret. REQUIRED in production (app refuses to boot without it).
JWT_SECRET=change-me-to-a-long-random-secret
# Access-token lifetime (e.g. 15m) and refresh-token lifetime in days.
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# Refresh-cookie flags. Secure cookies are forced in production regardless.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Google OAuth (https://console.cloud.google.com/apis/credentials). Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
