# AnatomiaX API env — copy to .env for local dev. See docs/deployment/README.md.
# Classification: ALL values here are SERVER-ONLY. Never expose via VITE_*/NEXT_PUBLIC_*.
PORT=3000
# Bind host. Local dev may use 127.0.0.1; production default is 0.0.0.0 (see main.ts).
HOST=127.0.0.1
# Comma-separated allow-list (web, admin). Production: HTTPS origins only, no "*" and no localhost.
# Convention: the FIRST entry is the web app — Google OAuth success redirects to <first>/auth/callback.
# CORS_ORIGINS (plural) is accepted as an alias — non-empty plural wins. Entries are
# trimmed, dequoted, lowercased; boot logs the normalized list. Unset in production fails boot.
CORS_ORIGIN=http://localhost:5173
# PostgreSQL connection string (Prisma). Never commit real credentials.
# Example: postgresql://postgres:postgres@localhost:5432/anatomiax
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anatomiax
# JWT access-token signing secret. REQUIRED in production (app refuses to boot without it).
JWT_SECRET=change-me-to-a-long-random-secret
# Access-token lifetime (e.g. 15m) and refresh-token lifetime in days.
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# Password-reset token lifetime in minutes (single-use, hashed at rest).
PASSWORD_RESET_TTL_MINUTES=60
# Refresh-cookie flags. Secure cookies are forced in production regardless.
# SameSite default is environment-aware: lax locally, none in production
# (cross-site Vercel frontend ↔ Render API must send the cookie on fetch;
# a Lax cookie stores on the OAuth 302 yet is never sent — /refresh 401s
# forever). Explicit COOKIE_SAMESITE still wins, but production boot
# rejects explicit lax/strict (silent refresh breakage) — leave unset or
# set none with COOKIE_SECURE=true (browser-enforced pairing).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Google OAuth (https://console.cloud.google.com/apis/credentials). Never commit real values.
# Optional: leave both ID and SECRET empty to disable. If enabled, set both plus a
# non-localhost HTTPS GOOGLE_CALLBACK_URL in staging/production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Push notifications (Firebase Admin SDK / FCM HTTP v1). Empty = sender stays stubbed, nothing is sent.
# On Render / production: provide credentials from your Firebase service account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional alternatives:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Transactional email (Brevo SMTP), server-only. REQUIRED in production
# (boot fails without SMTP_HOST — reset requests promise delivery).
# Empty SMTP_HOST keeps the safe stub for development/test only: reset
# requests resolve without sending so no mail infrastructure is needed.
# Brevo SMTP relay: smtp-relay.brevo.com on port 587 (STARTTLS, secure=false).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM=AnatomiaX <verified-sender@example.com>
