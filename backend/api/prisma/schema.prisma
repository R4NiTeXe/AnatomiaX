// AnatomiaX production data model (STEP 8.19.18).
//
// Stores ONLY identity, cohorts, learning records, and push subscriptions.
// Static anatomy content (seed, provenance, relationships), GLBs/meshes,
// registry/lineage data, and client UI state (camera, hover, layers) are
// intentionally NOT modeled here and must never be added to this schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum CohortMemberRole {
  STUDENT
  TEACHER
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  passwordHash String?
  name         String?
  role         UserRole  @default(STUDENT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  oauthAccounts       OAuthAccount[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  cohortsCreated      Cohort[]             @relation("CohortCreator")
  assignmentsCreated  CohortAssignment[]   @relation("AssignmentCreator")
  memberships         CohortMember[]
  quizAttempts        QuizAttempt[]
  quizzesAuthored     Quiz[]               @relation("QuizAuthor")
  progressSnapshot    ProgressSnapshot?
  pushSubscriptions   PushSubscription[]

  @@index([role])
  @@index([deletedAt])
  @@index([role, deletedAt])
  @@index([createdAt])
  @@map("users")
}

model OAuthAccount {
  id          String   @id @default(uuid())
  provider    String
  providerSub String
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSub])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  deviceLabel String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, usedAt])
  @@map("password_reset_tokens")
}

model Cohort {
  id               String    @id @default(uuid())
  name             String
  institutionLabel String?
  inviteCode       String    @unique @default(uuid())
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdById String?
  createdBy   User?   @relation("CohortCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members CohortMember[]

  assignments CohortAssignment[]

  @@index([createdById])
  @@index([createdAt])
  @@index([archivedAt])
  @@map("cohorts")
}

model CohortMember {
  id       String           @id @default(uuid())
  role     CohortMemberRole @default(STUDENT)
  joinedAt DateTime         @default(now())

  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@index([userId])
  @@index([cohortId])
  @@index([cohortId, joinedAt])
  @@map("cohort_members")
}

// Curriculum module assigned to a cohort (STEP 8.52).
// moduleKey references the frontend static module registry by anatomy
// system key (skin, musculoskeletal, …) — static content stays out of this
// schema per the header rule; only the assignment link is persisted.
model CohortAssignment {
  id        String   @id @default(uuid())
  moduleKey String
  createdAt DateTime @default(now())

  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  assignedById String?
  assignedBy   User?   @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([cohortId, moduleKey])
  @@index([cohortId])
  @@index([cohortId, createdAt])
  @@map("cohort_assignments")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  bodyModel   String
  score       Int
  total       Int
  answers     Json
  startedAt   DateTime?
  completedAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nullable: legacy free-form attempts (static-content quizzes) carry no
  // bank quiz. Bank-graded attempts always set quizId + questionSnapshot
  // (immutable per-question copy so later quiz edits never rewrite history).
  quizId           String?
  quiz             Quiz?   @relation(fields: [quizId], references: [id], onDelete: SetNull)
  questionSnapshot Json?

  @@index([userId, completedAt])
  @@index([quizId])
  @@map("quiz_attempts")
}

// Authoritative question bank (server-side grading). Assessment records like
// QuizAttempt — static anatomy *content* stays out of this schema per the
// header rule; only the gradable bank structure lives here.
model Quiz {
  id          String     @id @default(uuid())
  title       String
  description String?
  bodyModel   String?
  status      QuizStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdById String?
  createdBy   User?   @relation("QuizAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@map("quizzes")
}

model QuizQuestion {
  id           String   @id @default(uuid())
  prompt       String
  options      Json
  correctIndex Int
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([quizId, position])
  @@map("quiz_questions")
}

// Privileged-action ledger. No FK to User (survives account deletion) and
// NEVER authentication material (see AuditService for the field contract).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorRole  String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model ProgressSnapshot {
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studiedKeys String[]
  bodyModel   String?
  updatedAt   DateTime @updatedAt

  @@map("progress_snapshots")
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("push_subscriptions")
}
